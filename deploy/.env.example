# Configuración de Ruta-viva.
#
#   cp .env.example .env   y llenar los valores
#   chmod 600 .env
#
# .env está en .gitignore. NUNCA commitearlo.
#
# Generar las contraseñas, no inventarlas, y con -hex (NO -base64): terminan
# dentro de URLs de conexión en docker-compose.yml, y base64 puede producir
# '/', '+' o '=', que rompen esas URLs. hex solo usa 0-9a-f.
#   openssl rand -hex 32

# ── Dueño de la base ────────────────────────────────────────────────────────
# Solo lo usa el servicio `migrar`. Es DUEÑO de las tablas: la app jamás se
# conecta con él.
POSTGRES_DB=rutaviva
POSTGRES_USER=rutaviva_admin
POSTGRES_PASSWORD=

# ── Rol de la aplicación (rutaviva_app) ─────────────────────────────────────
# Con este se conecta el API. Solo puede leer, insertar y actualizar
# ferreterías y visitas: no puede borrar ni cambiar el esquema. Lo crea y le
# fija la contraseña el servicio `migrar` en cada arranque; para rotarla basta
# cambiarla aquí y volver a hacer `docker compose up -d`.
APP_DB_PASSWORD=

# ── Clave del equipo ────────────────────────────────────────────────────────
# Se escribe una vez en cada celular (Datos → Sincronización). Sin ella el API
# no acepta ni entrega datos. Mínimo 16 caracteres.
#   openssl rand -hex 16
CLAVE_EQUIPO=

# ── HTTPS con Caddy (servidor con IP pública) ───────────────────────────────
# Dirección de la app. Sin dominio propio sirve sslip.io con la IP del servidor
# separada por guiones: 136.108.178.241 -> 136-108-178-241.sslip.io
# Solo se usa con: docker compose --profile https up -d
DOMINIO=

# ── Túnel de ngrok (URL pública fija con HTTPS) ─────────────────────────────
# Authtoken y dominio estático gratis en https://dashboard.ngrok.com
# Solo se usan con: docker compose --profile tunel up -d
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ── Respaldos (deploy/backup.sh) ────────────────────────────────────────────
# Cifrado recomendado con age y clave PÚBLICA (la privada no vive en el servidor):
# BACKUP_RECIPIENT=age1...
# Alternativa: gpg simétrico con frase de paso.
# BACKUP_PASSPHRASE=
# Cuántos respaldos conservar.
# BACKUP_CONSERVAR=14

# ── Opcionales ──────────────────────────────────────────────────────────────
# Volumen de datos. Cambiarlo estrena una base limpia sin borrar la anterior.
PG_VOLUME=rutaviva_pgdata
# Puerto en 127.0.0.1 al usar docker-compose.local.yml.
PUERTO_LOCAL=8080
